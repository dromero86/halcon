{
    "version": "2",
    "cache": {
        "policy": "versioned"
    },
    "viewport": {
        "width": "device-width",
        "initialScale": 1
    },
    "parallel": true,
    "concurrency": 4,
    "clean": false,
    "resources": [
        {
            "id": "app-config",
            "type": "json",
            "url": "config/app.json"
        },
        {
            "id": "favicon",
            "type": "icon",
            "url": "ui/img/favicon.ico"
        },
        {
            "id": "zorzal",
            "type": "css",
            "url": "vendor/zorzal/zorzal-0.1.0.min.css",
            "cache": "immutable"
        },
        {
            "id": "theme",
            "type": "css",
            "url": "compat/theme.css",
            "deps": ["zorzal"]
        },
        {
            "id": "app",
            "type": "module",
            "url": "app/main-zorzal.js",
            "deps": ["app-config", "zorzal", "theme"]
        }
    ]
}
