{
    "$schema": "https://opencode.ai/config.json",
    "permissions": [
        { "action": "external_directory", "resource": "/opt/bitnami/ssot/*", "effect": "deny" },
        { "action": "read", "resource": "/opt/bitnami/ssot/*", "effect": "deny" },
        { "action": "edit", "resource": "/opt/bitnami/ssot/*", "effect": "deny" }
    ]
}
